flowchart TD
    U(["Files uploaded<br/>CSV · XLSX · multiple files"]) --> P["catalog.ingest<br/>Profile every column"]
    P --> SC[["Schema Card<br/>grain · history table · case-fold<br/>null coverage · foreign keys"]]

    Q(["Question in English"]) --> PL
    SC --> PL["planner.plan<br/>Single model call"]
    DEF[/"Settled Definitions<br/>Pinned for the session"/] --> PL

    PL --> G1{"GATE 1<br/>Can the question be answered<br/>from these columns?"}
    G1 -->|No| R1["REFUSE<br/>Explain what data is missing"]
    G1 -->|Yes| G2{"GATE 2<br/>Is every term defined<br/>by the available data?"}

    G2 -->|No| CL["CLARIFY<br/>Offer 2–4 options using<br/>real column names"]
    CL -->|User selects| DEF
    G2 -->|Yes| SQL["Model proposes SQL"]

    SQL --> G3{"GATE 3 — Guard<br/>Parses · resolves · read-only?"}
    G3 -->|No · first failure| RP["REPAIR ONCE<br/>Feed guard error back to model"]
    RP --> G3
    G3 -->|No · failed twice| R2["REFUSE<br/>Explain the guard failure plainly"]
    G3 -->|Yes| EX["EXECUTE<br/>DuckDB · external access disabled"]

    EX --> NR["Model drafts the answer sentence"]
    NR --> G4{"GATE 4<br/>Does every number<br/>exist in the result rows?"}
    G4 -->|No| FB["DISCARD<br/>Use deterministic fallback"]
    G4 -->|Yes| CH
    FB --> CH["Chart Spec<br/>Built in Python · columns must exist<br/>2–50 rows"]

    CH --> AC(["ANSWER CARD<br/>Sentence · table · chart · executed SQL"])
    AC --> AU[("AUDIT LOG<br/>One line per turn")]

    R1 --> AU
    R2 --> AU
    CL --> AU

    classDef gate fill:#e4e7f5,stroke:#3d4a8c,stroke-width:2px,color:#191c1f
    classDef refuse fill:#f6e6e4,stroke:#b8322a,stroke-width:2px,color:#191c1f
    classDef clarify fill:#f6eeda,stroke:#8a6414,stroke-width:2px,color:#191c1f
    classDef answer fill:#e2ede8,stroke:#2e6455,stroke-width:2px,color:#191c1f
    classDef shape fill:#f6e6e4,stroke:#b8322a,stroke-width:2px,color:#191c1f

    class G1,G2,G3,G4 gate
    class R1,R2,FB refuse
    class CL,DEF clarify
    class SQL,EX,AC answer
    class SC shape
