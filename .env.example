# Copy to .env. .env is gitignored; never commit a live key.

GROQ_API_KEY=

# The model the planner and narrator run on. Rate limits are per-model:
# llama-3.3-70b-versatile allows 12,000 tokens per minute against
# openai/gpt-oss-20b's 8,000 — 50% more headroom for a one-word change.
PLUMB_MODEL=llama-3.3-70b-versatile

# groq (default, needs the key above) or ollama (http://localhost:11434, no key)
# PLUMB_PROVIDER=groq
