# Copy to .env. .env is gitignored; never commit a live key.

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Groq withdrew llama-3.3-70b-versatile from the free plan on 16 August 2026.
# openai/gpt-oss-20b is 8,000 TPM on the free tier.
PLUMB_MODEL=openai/gpt-oss-20b

# auto (route across every configured free tier), groq, openrouter, ollama, custom.
# Under `auto`, a rate-limited provider costs a retry against the next one
# rather than the whole turn — free tiers are small enough to hit mid-demo.
# PLUMB_PROVIDER=auto
# PLUMB_ROUTE=0        # disable failover even when a provider is pinned

# Every key below is a free tier that needs no credit card (September 2026).
# Each one present adds candidates to the pool; none is required.
#   Groq          30 RPM / 1,000 RPD      console.groq.com
#   OpenRouter    20 RPM / 50 RPD :free   openrouter.ai/keys
#   Google        15 RPM / 1,500 RPD      aistudio.google.com/app/apikey
#   Mistral       ~1B tokens/month        console.mistral.ai  (opts into training)
#   Cohere        trial key               dashboard.cohere.com
#   Cloudflare    Workers AI free tier    dash.cloudflare.com
#   Hugging Face  router free tier        huggingface.co/settings/tokens
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# CF_API_TOKEN=
# CF_ACCOUNT_ID=

# The model picker asks each provider what it can run today. Set to 0 to show
# only the offline fallback list in backend/providers.py.
# PLUMB_LIVE_MODELS=1

# Where Ollama listens, for both chat and model discovery.
# PLUMB_OLLAMA_URL=http://localhost:11434

# Browser origins allowed to call the API. Unset means the Vite dev server on
# PLUMB_DEV_PORT (5173); the built SPA is same-origin and needs neither.
# PLUMB_CORS_ORIGINS=https://plumb.example.com
# PLUMB_DEV_PORT=5173

# Sent to OpenRouter as HTTP-Referer, which is how it attributes calls.
# PLUMB_PUBLIC_URL=http://localhost:5173

# Any OpenAI-compatible server. The URL is checked before plumb POSTs to it.
# PLUMB_PROVIDER=custom
# PLUMB_CUSTOM_URL=http://localhost:11434/v1/chat/completions
# PLUMB_CUSTOM_KEY=
# PLUMB_CUSTOM_MODEL=qwen2.5-coder:7b-instruct
# PLUMB_ALLOW_PRIVATE_ENDPOINTS=1

# Dashboard — one planner call, several panels per broad question.
# PLUMB_DASHBOARD_PANELS=4       # default 4, hard max 6
# PLUMB_DASHBOARD_TIMEOUT_MS=20000
# PLUMB_DASHBOARD_SUMMARY=0      # set 1 for one optional summary paragraph
